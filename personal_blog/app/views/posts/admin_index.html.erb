<div class="container-narrow">
  <div class="admin-header">
    <h1>Admin Dashboard</h1>
    <p class="admin-subtitle">Manage your blog posts</p>
    <div class="admin-actions">
      <%= link_to "New Post", new_post_path, class: "btn btn-primary" %>
      <%= link_to "View Public Blog", posts_path, class: "btn btn-secondary" %>
    </div>
  </div>

  <% if @posts.any? %>
    <div class="admin-posts">
      <div class="posts-stats">
        <div class="stat">
          <span class="stat-number"><%= @posts.published.count %></span>
          <span class="stat-label">Published</span>
        </div>
        <div class="stat">
          <span class="stat-number"><%= @posts.draft.count %></span>
          <span class="stat-label">Drafts</span>
        </div>
        <div class="stat">
          <span class="stat-number"><%= @posts.count %></span>
          <span class="stat-label">Total</span>
        </div>
      </div>

      <div class="posts-table">
        <% @posts.each do |post| %>
          <div class="post-row">
            <div class="post-info">
              <h3 class="post-title">
                <%= link_to post.title, post %>
              </h3>
              <div class="post-meta">
                <% if post.published %>
                  <span class="badge badge-accent">Published</span>
                  <%= post.published_at&.strftime("%B %d, %Y") %>
                <% else %>
                  <span class="badge">Draft</span>
                  Created <%= post.created_at.strftime("%B %d, %Y") %>
                <% end %>
                <span class="post-slug">/posts/<%= post.slug %></span>
              </div>
            </div>
            <div class="post-actions">
              <%= link_to "Edit", edit_post_path(post), class: "btn btn-sm btn-secondary" %>
              <%= button_to "Delete", post_path(post), method: :delete, 
                    data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="empty-state">
      <h2 class="empty-state-title">No posts yet</h2>
      <p class="empty-state-message">Create your first post to get started.</p>
      <%= link_to "Create Post", new_post_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

<style>
.admin-header {
  text-align: center;
  margin-bottom: 3rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid #e2e8f0;
}

.admin-subtitle {
  color: #64748b;
  margin-bottom: 2rem;
}

.admin-actions {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

.posts-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 1rem;
  margin-bottom: 2rem;
}

.stat {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 1.5rem;
  text-align: center;
}

.stat-number {
  display: block;
  font-size: 2rem;
  font-weight: 700;
  color: #3b82f6;
  line-height: 1;
}

.stat-label {
  font-size: 0.875rem;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.posts-table {
  background: white;
  border-radius: 12px;
  border: 1px solid #e2e8f0;
  overflow: hidden;
}

.post-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem;
  border-bottom: 1px solid #f1f5f9;
}

.post-row:last-child {
  border-bottom: none;
}

.post-info {
  flex: 1;
}

.post-title {
  font-size: 1.125rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.post-title a {
  color: inherit;
  text-decoration: none;
}

.post-title a:hover {
  color: #3b82f6;
}

.post-meta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 0.875rem;
  color: #64748b;
}

.post-slug {
  font-family: monospace;
  background: #f8fafc;
  padding: 0.125rem 0.375rem;
  border-radius: 4px;
  border: 1px solid #e2e8f0;
}

.post-actions {
  display: flex;
  gap: 0.5rem;
}

@media (max-width: 768px) {
  .post-row {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  
  .post-actions {
    align-self: flex-end;
  }
  
  .admin-actions {
    flex-direction: column;
    align-items: center;
  }
}
</style>
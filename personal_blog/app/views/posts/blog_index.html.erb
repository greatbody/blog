<div class="blog-page">
  <div class="container-narrow">
    <!-- Blog Header -->
    <div class="blog-header">
      <h1 class="blog-title">Blog Posts</h1>
      <p class="blog-subtitle">All published articles and tutorials</p>
      <% if logged_in? %>
        <div class="blog-actions">
          <%= link_to "Admin Dashboard", admin_posts_path, class: "btn btn-secondary" %>
        </div>
      <% end %>
    </div>

    <!-- Posts List -->
    <% if @posts.any? %>
      <div class="blog-posts">
        <% @posts.each do |post| %>
          <article class="blog-post">
            <div class="blog-post-content">
              <h2 class="blog-post-title">
                <%= link_to post.title, post %>
              </h2>
              <p class="blog-post-excerpt">
                <%= truncate(strip_tags(render_markdown(post.content)), length: 200) %>
              </p>
              <div class="blog-post-meta">
                <time datetime="<%= post.published_at&.iso8601 %>" class="blog-post-date">
                  <%= post.published_at&.strftime("%B %d, %Y") %>
                </time>
                <span class="blog-post-reading-time">
                  <%= calculate_reading_time(post.content) %> min read
                </span>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <h2 class="empty-state-title">No published posts yet</h2>
        <p class="empty-state-message">Check back soon for new articles!</p>
        <% if logged_in? %>
          <%= link_to "Create First Post", new_post_path, class: "btn btn-primary" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<style>
.blog-page {
  padding: 3rem 0;
}

.blog-header {
  text-align: center;
  margin-bottom: 4rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid #e2e8f0;
}

.blog-title {
  font-size: 3rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  line-height: 1.1;
}

.blog-subtitle {
  font-size: 1.25rem;
  color: #64748b;
  margin-bottom: 2rem;
}

.blog-actions {
  margin-top: 1rem;
}

.blog-posts {
  display: flex;
  flex-direction: column;
  gap: 3rem;
}

.blog-post {
  background: white;
  border-radius: 12px;
  padding: 2.5rem;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  border: 1px solid #e2e8f0;
  transition: all 0.2s ease;
}

.blog-post:hover {
  transform: translateY(-2px);
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
}

.blog-post-title {
  font-size: 1.75rem;
  font-weight: 600;
  margin-bottom: 1rem;
  line-height: 1.3;
}

.blog-post-title a {
  color: inherit;
  text-decoration: none;
}

.blog-post-title a:hover {
  color: #3b82f6;
}

.blog-post-excerpt {
  font-size: 1.125rem;
  line-height: 1.6;
  color: #475569;
  margin-bottom: 1.5rem;
}

.blog-post-meta {
  display: flex;
  align-items: center;
  gap: 1rem;
  font-size: 0.875rem;
  color: #64748b;
}

.blog-post-date {
  font-weight: 500;
}

.blog-post-reading-time {
  font-style: italic;
}

@media (max-width: 768px) {
  .blog-title {
    font-size: 2.25rem;
  }
  
  .blog-post {
    padding: 2rem;
  }
  
  .blog-post-title {
    font-size: 1.5rem;
  }
  
  .blog-post-meta {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
}
</style>
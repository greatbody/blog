<div class="prose">
  <div class="flex justify-between items-center mb-2xl">
    <div>
      <h1 class="mb-sm"><%= @post.title %></h1>
      <div class="text-secondary">
        <% if @post.published %>
          Published on <%= @post.published_at.strftime("%B %d, %Y") %>
        <% else %>
          <span class="badge">Draft</span>
        <% end %>
      </div>
    </div>
    <div class="flex gap-sm">
      <%= link_to "Edit", edit_post_path(@post), class: "btn btn-secondary" %>
      <%= link_to "Back", posts_path, class: "btn btn-ghost" %>
    </div>
  </div>

  <hr>

  <article>
    <%= markdown(@post.content) %>
  </article>
</div>
